# ── FREE-Payment-Gateways configuration ─────────────────────────────
# Copy this file to `.env` and edit. Everything also has safe defaults.

# Port the gateway listens on (default: 3000)
PORT=3000

# Public base URL of this gateway. IMPORTANT for production.
# Local:   http://localhost:3000
# Cloud:   https://pay.yourdomain.com
BASE_URL=http://localhost:3000

# Path of the embedded SQLite database (default: ./data/fpg.db)
# DB_PATH=./data/fpg.db

# Admin password for the dashboard at /admin
# If unset on first run, a random one is generated and printed ONCE to the console.
ADMIN_PASSWORD=

# Set to "true" when behind a reverse proxy (nginx, Cloudflare, Render, …)
TRUST_PROXY=false
