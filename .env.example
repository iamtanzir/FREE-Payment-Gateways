# ── FREE Payment Gateways configuration ─────────────────────────────
# Copy this file to `.env` and edit. Everything also has safe defaults.

# Port the gateway listens on (default: 3000)
PORT=3000

# Public base URL of this gateway. IMPORTANT for production.
# Local:   http://localhost:3000
# Cloud:   https://pay.yourdomain.com
BASE_URL=http://localhost:3000

# Path of the embedded SQLite database (default: ./data/fpg.db)
# Ignored whenever TURSO_DATABASE_URL or DATABASE_URL is set.
# DB_PATH=./data/fpg.db

# ── Option 1 (recommended for Vercel): Turso / libSQL ──────────────
# Serverless SQLite over HTTPS — no TCP socket, no local disk, no pool limits.
# Free tier: 500 databases / 9 GB total, card not required.
#   1. https://turso.tech → sign in with GitHub → Create database
#   2. Copy the URL (libsql://… or turso://… — both work here)
#   3. Create a token: turso db tokens create <database-name>
# Vercel → Project → Settings → Environment Variables → add both, then redeploy.
# Guide: docs/VERCEL-TURSO.md
# TURSO_DATABASE_URL=libsql://your-db-yourname.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# ── Option 2: PostgreSQL (Supabase / Neon / Aiven / CockroachDB) ────
# Any Postgres-compatible FREE service works. On Vercel use a POOLED URL
# (Supabase: "Transaction pooler", port 6543; Neon: "Pooled connection").
# Vercel + Aiven step-by-step: docs/VERCEL-AIVEN.md
# All providers in one place: docs/DATABASE.md
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
#
# Supabase pooled example (the direct db.<ref>.supabase.co host is IPv6-only
# and uses a private CA — the pooler works from Vercel and public CAs):
# DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# Database verification (optional, recommended for Aiven Free):
# Aiven uses a self-signed certificate chain. Encryption always works; to VERIFY
# the server, download the CA from the Aiven console (Service → Overview →
# "CA Certificate") and point the app at it.
# DATABASE_CA_CERT_FILE=./aiven-ca.pem
# or inline (single line):
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----"

# Check a database before you rely on it:
#   npm run db:doctor          # Postgres (DATABASE_URL) or Turso (TURSO_DATABASE_URL)
#   npm run db:doctor -- --no-check   # TLS policy only, no network

# Max Postgres connections per app instance (default: 5).
# Serverless note: lower it (e.g. 3) on Aiven Free (20 connections total).
# PG_POOL_MAX=5

# Admin password for the dashboard at /admin
# Default on fresh installs: 12345678 — after first login, change it immediately
# under /admin → Settings → Change admin password (min 8 chars). The change is
# permanent and survives restarts/redeploys when using DATABASE_URL (external DB)
# or a persistent disk. Set this env to skip the default entirely.
ADMIN_PASSWORD=

# Set to "true" when behind a reverse proxy (nginx, Cloudflare, Render, …)
TRUST_PROXY=false

# ─── Public front door ───
# "/" is a public landing page that links to the merchant login (/admin/login).
# Set to 0 if you want the old behaviour: "/" redirects straight to /admin.
# LANDING_PAGE=1

# ─── Merchant SPA (multi-merchant, optional) ───
# Opt-in only. Without this, /app redirects to /admin (password-only, no email).
# SPA_ENABLED=1

# ─── Merchant SPA (src/dashboard) — only needed to BUILD the embedded app ───
# Free Supabase project: https://supabase.com (card not required)
# VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
# VITE_SUPABASE_PROJECT_ID="PROJECT_REF"
